# ===========================================================================
# Lone Star Winners - PLANTILLA de variables de entorno
#
# Este archivo es PUBLICO y esta versionado. Todos los valores de abajo son
# FALSOS y descriptivos (principios #19 y #20 de CLAUDE.md). Nunca se pega
# aqui un secreto real, ni siquiera "temporalmente".
#
# Uso:   cp .env.example .env      (el .env real esta ignorado por .gitignore)
#
# ---------------------------------------------------------------------------
# LO QUE **NO** VA EN ESTE ARCHIVO
# ---------------------------------------------------------------------------
# 1. Feature flags legalmente materiales (DEC-013). Viven en base de datos,
#    desactivados por defecto, con cambio auditado y `reason` obligatorio.
#    Prohibido leerlos desde variables de entorno, y muy especialmente desde
#    variables `NEXT_PUBLIC_*`.
# 2. Cualquier interruptor de sorteo interno (DEC-017). El sorteo exige cinco
#    cerrojos simultaneos, uno de ellos una entidad `DrawAuthorization` viva.
#    No existe -ni existira- una variable de entorno que lo active.
# 3. Constantes legales: edad minima, jurisdicciones, formulas de entries,
#    deadlines. Van en `PromotionRulesVersion` (DEC-012), nunca en el entorno.
# 4. Claves privadas de firma. Solo se referencia su localizacion (DEC-016).
#
# Toda variable nueva debe declararse ademas en el esquema de entorno validado
# en el arranque del proceso (DEC-018): si falta o es invalida, el proceso no
# arranca.
# ===========================================================================


# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development

# DEC-011: el proceso corre en UTC. La zona legal de cada promocion se declara
# en `promotion.legal_timezone`, nunca aqui y nunca en el navegador.
TZ=UTC

# trace | debug | info | warn | error
LOG_LEVEL=debug


# ---------------------------------------------------------------------------
# apps/api - Fastify standalone (DEC-004)
# ---------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
API_BODY_LIMIT_BYTES=1048576

# Origenes permitidos por CORS, separados por coma. En produccion nunca "*".
API_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Cabecera de correlacion de peticiones (aparece en `error.request_id`, DEC-022).
API_REQUEST_ID_HEADER=x-request-id

# Rate limiting (valores de desarrollo, no de produccion).
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_MAX_REQUESTS=120


# ---------------------------------------------------------------------------
# apps/web - Next.js standalone (DEC-004, DEC-021)
#
# Recordatorio: todo lo que empieza por NEXT_PUBLIC_ se sirve al navegador.
# Ahi no va ningun flag legalmente material ni ninguna clave.
# ---------------------------------------------------------------------------
WEB_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Base de la API para las llamadas que hace el SERVIDOR de Next (Server
# Components, route handlers, `generateMetadata`). Deliberadamente SIN
# `NEXT_PUBLIC_`: no se sirve al navegador, y en despliegue puede apuntar a una
# direccion interna que el navegador no deberia conocer ni poder alcanzar.
# La variante `NEXT_PUBLIC_API_BASE_URL` sigue siendo la del navegador.
API_BASE_URL=http://localhost:4000/api/v1

# Interruptor de los mocks de red de `apps/web` (MSW) en desarrollo y test.
# Nunca `true` en produccion: la validacion de arranque lo rechaza.
WEB_ENABLE_API_MOCKS=true

# DEC-021: ambos locales llevan prefijo de ruta (/en, /es). No existe locale
# por defecto sin prefijo, asi que aqui no se configura ninguno.


# ---------------------------------------------------------------------------
# PostgreSQL (DEC-003) - TRES roles diferenciados, no uno
#
#   migrator ......... DDL. Solo lo usa el runner de migraciones (DEC-005).
#   app .............. DML de la aplicacion. SIN UPDATE/DELETE sobre las tablas
#                      de ledger y auditoria (DEC-007). Si tu rol `app` local
#                      puede hacer UPDATE sobre `entry_transactions`, tu entorno
#                      esta mal configurado y los tests de invariante lo diran.
#   readonly_report .. lectura para informes y auditoria.
#
# Restriccion vinculante de DEC-003: un hosting que no permita crear roles de
# base de datos diferenciados queda descartado.
# ---------------------------------------------------------------------------
DATABASE_URL_MIGRATOR=postgresql://lsw_migrator:LOCAL_DEV_PASSWORD_CHANGE_ME@127.0.0.1:5432/lone_star_winners
DATABASE_URL_APP=postgresql://lsw_app:LOCAL_DEV_PASSWORD_CHANGE_ME@127.0.0.1:5432/lone_star_winners
DATABASE_URL_READONLY=postgresql://lsw_readonly_report:LOCAL_DEV_PASSWORD_CHANGE_ME@127.0.0.1:5432/lone_star_winners

# disable | require | verify-ca | verify-full
# El modo exigible depende de DATABASE_NETWORK (ver justo debajo):
#   DATABASE_NETWORK=public  -> en produccion DEBE ser verify-full.
#   DATABASE_NETWORK=private -> en produccion DEBE ser disable.
DATABASE_SSL_MODE=disable

# DEC-043. Por que camino de red viaja la conexion a PostgreSQL.
#
#   public  .. cruza Internet. Es el valor por defecto si no se declara, y
#              obliga a verificar el certificado en produccion.
#   private .. no sale de la red privada del proveedor (en Railway,
#              `*.railway.internal`). Ese proveedor emite certificados
#              autofirmados, asi que `verify-full` es inalcanzable y `require`
#              solo aparentaria seguridad: cifra sin verificar, que no protege
#              de un intermediario. En ese caso la garantia la da el
#              aislamiento de red y el modo coherente es `disable`.
#
# Declarar `private` sobre una red que no lo sea deja la base de datos en
# claro. Es una afirmacion sobre la topologia, no un interruptor de comodidad.
DATABASE_NETWORK=public

DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Arranque en frio de una base gestionada (DEC-043)
#
# Solo las usa `pnpm --filter @lsw/database db:bootstrap`, nunca el proceso que
# sirve HTTP. Existen porque en una base recien creada el rol `lsw_migrator`
# todavia no existe -lo crea `0000_baseline.sql`- y se crea sin contrasena a
# proposito: una contrasena dentro de una migracion seria una contrasena
# versionada. El unico credencial disponible el minuto cero es el superusuario
# que crea el proveedor.
#
# En local NO hacen falta: el arranque en frio local se resuelve con
# `packages/database/sql/local-dev/set-role-passwords.sql`.
# ---------------------------------------------------------------------------
DATABASE_URL_SUPERUSER=
LSW_DB_MIGRATOR_PASSWORD=
LSW_DB_APP_PASSWORD=
LSW_DB_READONLY_PASSWORD=


# ---------------------------------------------------------------------------
# Segundo factor (DEC-006, DEC-045)
#
# Clave AES-256 con la que se cifra el secreto TOTP antes de guardarlo en
# identity_mfa_factors. NO es un hash: el secreto hay que poder leerlo para
# generar el codigo esperado, asi que la unica proteccion posible es cifrarlo
# con una clave que no viva en la base de datos.
#
# 32 bytes en base64url. Generar con:
#   node -e 'console.log(require("node:crypto").randomBytes(32).toString("base64url"))'
#
# Rotarla invalida TODOS los factores MFA inscritos: nadie podra completar un
# segundo factor hasta volver a inscribirse.
# ---------------------------------------------------------------------------
MFA_SECRET_ENCRYPTION_KEY=CHANGE_ME_GENERA_32_BYTES_EN_BASE64URL

# Proveedor concreto (Neon / RDS / Supabase / otro) TODAVIA SIN DECIDIR.
# Ver la nota de DEC-003. No se asuma ninguno.


# ---------------------------------------------------------------------------
# Jobs y colas - pg-boss sobre el mismo PostgreSQL (DEC-020)
#
# Encolar un job y escribir en el ledger deben ocurrir en la MISMA transaccion.
# Por eso la cola vive en la base de datos y no en Redis.
# ---------------------------------------------------------------------------
PGBOSS_SCHEMA=pgboss
PGBOSS_POLL_INTERVAL_SECONDS=2
# Deja vacio para reutilizar DATABASE_URL_APP.
PGBOSS_DATABASE_URL=


# ---------------------------------------------------------------------------
# Identidad y sesiones (DEC-006) - un unico sistema, participantes y admin
# ---------------------------------------------------------------------------
# Secreto de firma/derivacion de sesiones opacas. Genera uno propio en local:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=FAKE_LOCAL_ONLY_replace_with_48_random_bytes_base64url

SESSION_COOKIE_NAME=lsw_session
SESSION_COOKIE_DOMAIN=localhost
# false SOLO en desarrollo sobre http. En cualquier otro entorno: true.
SESSION_COOKIE_SECURE=false
SESSION_TTL_MINUTES=720
ADMIN_SESSION_TTL_MINUTES=60
ADMIN_SESSION_IDLE_TIMEOUT_MINUTES=15

# Step-up auth: ventana maxima desde el ultimo MFA para operaciones sensibles
# (descarga de export, finalizacion de snapshot, inicio de sorteo, cambio de
# rol, cambio de flag legalmente material, ajuste manual). DEC-006 fija <= 5 min.
STEP_UP_MAX_AGE_SECONDS=300

# Argon2id (DEC-006). Parametros de desarrollo; produccion los endurece.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# MFA/TOTP obligatorio para todo rol administrativo.
MFA_TOTP_ISSUER=Lone Star Winners (local)
MFA_TOTP_WINDOW=1


# ---------------------------------------------------------------------------
# Auditoria y sellado externo (DEC-008)
#
# El `chain_head_hash` de cada promocion se sella a diario en un almacen
# externo write-once, FUERA del alcance del rol `app`. Proveedor sin decidir:
# los nombres son deliberadamente neutrales.
# ---------------------------------------------------------------------------
AUDIT_CHAIN_CANONICALIZATION_VERSION=1
AUDIT_CHAIN_VERIFIER_CRON=0 3 * * *

AUDIT_SEAL_STORAGE_ENDPOINT=http://localhost:9000
AUDIT_SEAL_STORAGE_BUCKET=lsw-audit-seals-local
AUDIT_SEAL_STORAGE_REGION=us-east-1
AUDIT_SEAL_STORAGE_ACCESS_KEY_ID=FAKE_LOCAL_ACCESS_KEY_ID
AUDIT_SEAL_STORAGE_SECRET_ACCESS_KEY=FAKE_LOCAL_SECRET_ACCESS_KEY
# El bucket real debe tener object-lock / WORM activado.
AUDIT_SEAL_OBJECT_LOCK_REQUIRED=true


# ---------------------------------------------------------------------------
# Export snapshots y entrega al TPA (DEC-016)
#
# La clave privada de firma NUNCA vive en el repositorio ni en el .env: aqui
# solo se referencia donde encontrarla, y en produccion viene del gestor de
# secretos.
# ---------------------------------------------------------------------------
EXPORT_STORAGE_ENDPOINT=http://localhost:9000
EXPORT_STORAGE_BUCKET=lsw-exports-local
EXPORT_SIGNING_KEY_ID=local-dev-export-key-2026
EXPORT_SIGNING_KEY_PATH=/ruta/fuera/del/repositorio/lsw-export-signing.key
EXPORT_SCHEMA_VERSION=1


# ---------------------------------------------------------------------------
# Commerce y pagos
#
# ATENCION: el procesador de pagos NO esta decidido (CLAUDE.md seccion 7).
# Estas variables son un contrato provisional y neutral de proveedor; la
# eleccion real requiere su propio DEC.
# ---------------------------------------------------------------------------
# none | <proveedor a decidir>
PAYMENT_PROVIDER=none
PAYMENT_PROVIDER_API_BASE_URL=https://api.proveedor-de-pagos.ejemplo/v1
PAYMENT_PROVIDER_API_KEY=FAKE_LOCAL_PAYMENT_API_KEY
# Verificacion de firma del webhook. Sin ella, un tercero podria fabricar
# eventos de pago y, con ellos, entries (DEC-009).
PAYMENT_WEBHOOK_SIGNING_SECRET=FAKE_LOCAL_WEBHOOK_SIGNING_SECRET
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300

# Moneda por defecto del catalogo. DEC-010: el dinero se maneja SIEMPRE en
# enteros de unidad menor mas la moneda explicita. Nunca en coma flotante.
DEFAULT_CURRENCY=USD


# ---------------------------------------------------------------------------
# Email - proveedor SIN DECIDIR
# ---------------------------------------------------------------------------
# console | <proveedor a decidir>
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=no-reply@localhost.ejemplo
EMAIL_FROM_NAME=Lone Star Winners (local)
EMAIL_PROVIDER_API_KEY=FAKE_LOCAL_EMAIL_API_KEY


# ---------------------------------------------------------------------------
# Observabilidad - proveedor sin decidir
# ---------------------------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=lsw-api


# ---------------------------------------------------------------------------
# Tests (DEC-018)
#
# Los tests de ledger, concurrencia y rangos corren contra PostgreSQL real via
# Testcontainers. Mocks y SQLite estan descartados explicitamente.
# ---------------------------------------------------------------------------
TEST_DATABASE_URL=postgresql://lsw_migrator:LOCAL_DEV_PASSWORD_CHANGE_ME@127.0.0.1:5432/lone_star_winners_test
TESTCONTAINERS_POSTGRES_IMAGE=postgres:16-alpine
TESTCONTAINERS_RYUK_DISABLED=false
E2E_BASE_URL=http://localhost:3000
