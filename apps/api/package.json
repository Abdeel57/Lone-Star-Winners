{
  "name": "@lsw/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "API HTTP de Lone Star Winners. Fastify 5 standalone (DEC-004).",
  "license": "UNLICENSED",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsc -p tsconfig.build.json && node --watch --enable-source-maps dist/server.js",
    "start": "node --enable-source-maps dist/server.js",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "contract:emit": "tsc -p tsconfig.build.json && node dist/scripts/emit-contract.js",
    "contract:check": "pnpm run contract:emit && git diff --exit-code -- openapi"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@lsw/audit": "workspace:*",
    "@lsw/commerce": "workspace:*",
    "@lsw/database": "workspace:*",
    "@lsw/security": "workspace:*",
    "@lsw/sweepstakes": "workspace:*",
    "@lsw/tpa": "workspace:*",
    "drizzle-orm": "^0.44.4",
    "fastify": "^5.6.0",
    "pino": "^9.9.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
