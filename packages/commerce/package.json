  "type": "module",
  "description": "Puerto neutral de proveedor de pagos y tipos de commerce. B0: SOLO el puerto, ningun proveedor concreto.",
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
